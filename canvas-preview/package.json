{
  "name": "ap-dm-canvas-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local Vite host that aliases cursor/canvas to cursor-canvas-web and previews any .canvas.tsx under watched roots.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "associate": "node --experimental-strip-types print-canvas-associations.ts"
  },
  "dependencies": {
    "@mantine/charts": "^8.3.18",
    "@mantine/core": "^8.3.18",
    "@thisismydesign/cursor-canvas-web": "^0.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
